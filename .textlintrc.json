{
  "filters": {
    "comments": true
  },
  "rules": {
    "preset-ai-words-ja": {
      "no-ai-words": {
        "dictionaryPath": "./.textlint/words.json",
        "dictionaryMode": "override"
      }
    },
    "@textlint-ja/preset-ai-writing": {
      "ai-tech-writing-guideline": false
    },
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 150
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "である",
        "preferInList": "である",
        "strict": false
      },
      "no-doubled-joshi": false,
      "ja-no-mixed-period": false,
      "no-unmatched-pair": false
    }
  }
}
