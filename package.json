{
  "name": "skills",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "format:js": "oxfmt \"**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}\"",
    "format:js:check": "oxfmt --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}\"",
    "lint:js": "oxlint",
    "lint:fallow": "fallow --skip dupes --baseline .config/fallow/dead-code-baseline.json --health-baseline .config/fallow/health-baseline.json --fail-on-issues --quiet --format compact || { rc=$?; echo 'fallow: 使われていないコードは fallow fix --dry-run で提案を確かめてから直す（fallow fix）。誤検知は .fallowrc.jsonc で外す（docs/tooling.md「ファイルの間の関係（fallow）」）' >&2; exit $rc; }",
    "lint:crap": "fallow health -c .config/fallow/crap.jsonc --coverage node_modules/.cache/coverage/report/coverage-final.json --baseline .config/fallow/crap-baseline.json --fail-on-issues --quiet --format compact",
    "lint:duplicates": "node scripts/gates/code/check-duplicates.ts",
    "lint:prose": "node scripts/gates/prose/lint-prose.ts",
    "test": "vitest run",
    "test:coverage": "node scripts/coverage/run-coverage.ts",
    "typecheck": "tsc -b --force"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@prantlf/jsonlint": "^17.0.1",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild": "0.28.2",
    "fallow": "3.35.0",
    "js-yaml": "^5.4.3",
    "jscpd": "5.4.2",
    "jsonc-parser": "3.3.1",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.23.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "^25.0.9",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ai-words-ja": "^1.2.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.13.0"
}
