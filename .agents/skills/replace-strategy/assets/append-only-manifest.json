{
  "_note": "追記専用（非破壊追記）の成果物の一覧（正本）。replace-strategy の scripts/append-only-check.mjs が読む。散文の中にある限り書き手が読み落としても何も起きないため、機械可読にしてここへ集約する。パターンは .replace / .config を起点にしたリポジトリルートからの相対パスで、* は 1 階層、** は複数階層に一致する。プロジェクト側の置き場所が既定と違う場合はこのファイルをプロジェクトへコピーして書き換え、--manifest で渡す（スキル内の正本は書き換えない）。",
  "version": "1",
  "artifacts": [
    {
      "id": "project-config",
      "pattern": ".config/skills/*/skills.yml",
      "requirement": "既にあれば欠けたキーだけを追記し、既存のキー・値・コメントは変更しない",
      "source": "replace-strategy の references/project-config.md"
    },
    {
      "id": "features",
      "pattern": ".replace/features.md",
      "requirement": "非破壊更新で節・列を追加して埋める。テンプレートに無いヘッダ項目・節・列・行を書き直しで削除しない",
      "source": "replace-strategy の references/features-issues.md"
    },
    {
      "id": "components",
      "pattern": ".replace/components.md",
      "requirement": "既存の行・ヘッダ項目・テンプレートに無い追記も、書き直しで落とさない",
      "source": "replace-strategy の assets/components-template.md"
    },
    {
      "id": "assets",
      "pattern": ".replace/assets.md",
      "requirement": "既存の決定を書き換えず、覆すときは新しい決定を追記して前の決定に覆した理由を書く",
      "source": "replace-strategy の references/static-assets.md"
    },
    {
      "id": "dependencies",
      "pattern": ".replace/dependencies.md",
      "requirement": "既存の決定を書き換えない。差し替えたときは新しい決定を追記し、前の決定に差し替え理由を書く",
      "source": "replace-strategy の references/dependency-selection.md"
    },
    {
      "id": "dataset-metadata",
      "pattern": ".replace/dataset/metadata.json",
      "requirement": "版ごとの changes[] は非破壊で追加する。過去版の記録を推測で書き換えない",
      "source": "golden-dataset の references/versioning.md"
    },
    {
      "id": "component-diff-exceptions",
      "pattern": ".replace/parity/*/component-diff-exceptions.json",
      "requirement": "インスタンス例外の台帳。承認済みの例外を非破壊追記する（過去の承認を消さない）",
      "source": "parity-diff の references/triage.md"
    },
    {
      "id": "component-diff-exceptions-rationale",
      "pattern": ".replace/parity/*/component-diff-exceptions.md",
      "requirement": "承認の根拠（いつ誰が何件を覆って承認したか）を非破壊追記する。収束判定が承認済み件数をここから数える",
      "source": "parity-diff の references/triage.md"
    },
    {
      "id": "gaps",
      "pattern": ".replace/parity/*/gaps.md",
      "requirement": "未検証領域の記録。測れなかった事情を消さずに残す（確認済みにしない）",
      "source": "parity-suite の assets/gaps-template.md"
    }
  ]
}
