node_modules/

# mise が読み込む開発者固有の環境変数（共有既定はリポジトリ設定に置く）
.env.local

# テスト実行結果の詳細は除外、サマリーは保持
tests/*/iteration-*/eval-*/

# check-mutation-proof.test.js の使い捨て fixture / ロック（異常終了時の残骸）
scripts/mutation-proof-fixture-*/
scripts/mutation-proof-lock-*/

# eval ビューアが生成する閲覧用 HTML（run 出力を埋め込んだ数百 KB の生成物。サマリーではない）
tests/*/iteration-*/review.html

# kaizen の制御ファイル（Hook / 抽出完了時に作成する一時ファイル）
# ルートだけでなく、万一サブディレクトリに迷子で作られた場合も除外する（二重の防御）。
**/.kaizen/.pending-extract*
**/.kaizen/.extract-done*
**/.kaizen/.extract-checkpoint*

# scheduled tasks のロックファイル
.claude/scheduled_tasks.lock

# git-worktree スキルの worktree 置き場（リポジトリ内配置）。
# 末尾スラッシュを付けない——git はシンボリックリンクをディレクトリとして見ないため、
# `/.claude/worktrees/` だとリンクを運び込んだ場合に一致せず未追跡として現れる。
/.claude/worktrees
