{
  "rules": [
    {
      "path": "scripts/",
      "lines": 90,
      "branches": 80,
      "functions": 90
    },
    {
      "path": "scripts/lib/",
      "lines": 95,
      "branches": 85,
      "functions": 95
    },
    {
      "path": "scripts/eval/",
      "lines": 80,
      "branches": 70,
      "functions": 80
    },
    {
      "path": "scripts/tools/",
      "lines": 80,
      "branches": 70,
      "functions": 80
    },
    {
      "path": "skills/",
      "lines": 90,
      "branches": 80,
      "functions": 90
    },
    {
      "path": ".agents/skills/",
      "lines": 90,
      "branches": 80,
      "functions": 90
    }
  ],
  "exclude": [
    {
      "path": "scripts/eval/fixtures/generate-parity-component-fixtures.ts",
      "reason": "eval の fixture を実 Chrome で生成するツールで、テストの中では Chrome を起動しない"
    },
    {
      "path": "skills/parity-diff/assets/capture-new.spec.template.ts",
      "reason": "利用者のリポジトリにコピーして Playwright で実行する雛形で、このリポジトリでは読み込まない"
    },
    {
      "path": "skills/parity-suite/assets/perf-capture.spec.template.ts",
      "reason": "利用者のリポジトリにコピーして Playwright で実行する雛形で、実ブラウザを起動する"
    },
    {
      "path": "skills/replace-strategy/scripts/page/asset-probe.page.mjs",
      "reason": "ページで実行するコードで、CLI が本文を関数式で包んで出し、chrome-devtools MCP の evaluate_script がブラウザの中で実行する。テストも CLI の出力を vm で評価するので、このファイルとしては読み込まれず、カバレッジに数えられない"
    },
    {
      "path": "skills/replace-strategy/scripts/page/role-probe.page.mjs",
      "reason": "ページで実行するコードで、CLI が本文を関数式で包んで出し、chrome-devtools MCP の evaluate_script がブラウザの中で実行する。テストも CLI の出力を vm で評価するので、このファイルとしては読み込まれず、カバレッジに数えられない"
    }
  ]
}
