{
  "$comment": ["gates-layout.test.ts の検出能力を示す変異の一覧。"],
  "test_file": "scripts/gates/code/gates-layout.test.ts",
  "mutations": [
    {
      "id": "GL-ROOT-FILES",
      "why": "直下のファイルを違反にしない",
      "file": "scripts/gates/code/gates-layout.test.ts",
      "find": "      if (!entry.isDirectory()) violations.push",
      "replace": "      if (false) violations.push",
      "occurrences": 1,
      "expect_failing": [
        "scripts の直下のファイルを違反にする",
        "scripts/gates の直下のファイルを違反にする"
      ]
    },
    {
      "id": "GL-LIMIT",
      "why": "上限を超えた分類を違反にしない",
      "file": "scripts/gates/code/gates-layout.test.ts",
      "find": "    if (files > MAX_FILES_PER_CATEGORY) violations.push",
      "replace": "    if (false) violations.push",
      "occurrences": 1,
      "expect_failing": ["21 ファイル（入れ子を含む）の分類を違反にする"]
    },
    {
      "id": "GL-OFF-BY-ONE",
      "why": "上限ちょうどの分類を違反にする",
      "file": "scripts/gates/code/gates-layout.test.ts",
      "find": "    if (files > MAX_FILES_PER_CATEGORY) violations.push",
      "replace": "    if (files >= MAX_FILES_PER_CATEGORY) violations.push",
      "occurrences": 1,
      "expect_failing": [
        "分類の下に置いた 20 ファイル（入れ子を含む）と、直下のディレクトリは違反にしない"
      ]
    },
    {
      "id": "GL-NESTED",
      "why": "入れ子のファイルを数えない",
      "file": "scripts/gates/code/gates-layout.test.ts",
      "find": "(entry.isDirectory() ? countFiles(join(dir, entry.name)) : 1)",
      "replace": "(entry.isDirectory() ? 0 : 1)",
      "occurrences": 1,
      "expect_failing": ["21 ファイル（入れ子を含む）の分類を違反にする"]
    }
  ]
}
