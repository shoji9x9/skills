{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "./node_modules/.cache/tsc/templates.tsbuildinfo"
  },
  "include": [
    "skills/*/**/*.ts",
    "skills/*/**/*.mts",
    "skills/*/**/*.cts",
    ".agents/skills/*/**/*.ts",
    ".agents/skills/*/**/*.mts",
    ".agents/skills/*/**/*.cts",
    "types/parity-templates.ts"
  ]
}
