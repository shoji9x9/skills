    {
      "file": "skills/parity-diff/scripts/pixel-crops.mjs",
      "exports": ["DEFAULT_COLOR_TOLERANCE", "hexToRgb"]
    },
    {
      "file": "skills/parity-diff/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/parity-replace/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/parity-suite/scripts/skill-config/skill-config.mjs",
