{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "skills/*/scripts/*.mjs",
    "skills/*/scripts/page/*.mjs",
    "skills/*/scripts/skill-config/skill-config.mjs",
    "skills/*/assets/**/*.{mjs,ts}",
    "scripts/coverage/**/*.ts",
    "scripts/eval/**/*.ts",
    "scripts/gates/**/*.ts",
    "scripts/hooks/**/*.ts",
    "scripts/mutation/**/*.ts",
    "scripts/tools/**/*.ts",
    ".agents/skills/*/scripts/**/*.ts",
    "types/**/*.ts"
  ],
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": false,
  "ignoreExports": [
    {
      "file": "skills/**",
      "exports": ["*"]
    },
    {
      "file": "scripts/gates/code/oxlint-plugin/plugin.ts",
      "exports": ["default"]
    },
    {
      "file": "scripts/lib/testing/vitest-global-setup.ts",
      "exports": ["setup"]
    },
    {
      "file": "scripts/lib/testing/fake-pngjs.ts",
      "exports": ["PNG"]
    },
    {
      "file": "types/skill-runtime/pngjs.ts",
      "exports": ["PNG"]
    },
    {
      "file": "types/skill-runtime/playwright.ts",
      "exports": ["Locator", "Page"]
    },
    {
      "file": "skills/agent-usage/scripts/lib/flags.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/agent-usage/scripts/lib/is-array.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/agent-usage/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
    },
    {
