    },
    {
      "file": "skills/golden-dataset/scripts/lib/is-array.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/golden-dataset/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/issue-batch/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/issue-start/scripts/lib/cli.mjs",
