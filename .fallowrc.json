    {
      "file": "skills/parity-component/scripts/lib/cli.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/parity-component/scripts/lib/flags.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/parity-component/scripts/lib/is-array.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/parity-component/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
