    {
      "file": "skills/replace-strategy/scripts/lib/cli.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/replace-strategy/scripts/lib/errors.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/replace-strategy/scripts/lib/flags.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/replace-strategy/scripts/lib/is-array.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/replace-strategy/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
    },
    {
      "file": "skills/writing-style/scripts/skill-config/skill-config.mjs",
      "exports": ["*"]
    }
