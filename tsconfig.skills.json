{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/skills.tsbuildinfo",
    "moduleDetection": "legacy"
  },
  "include": [
    "skills/*/scripts/**/*.mjs",
    "skills/*/assets/**/*.mjs",
    "types/strict-json.ts",
    "types/skill-runtime-modules.ts"
  ]
}
