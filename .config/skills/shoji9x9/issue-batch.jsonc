{
  "merge_mode": "auto", // auto | agent。auto はリポジトリの allow_auto_merge: true が前提
  "merge_method": "squash", // squash | merge | rebase
  "max_local_review_iterations": 1,
  "max_pr_iterations": 5,
  "wait_ci_before_review": false,
  "continue_on_blocked": true,
  "deployment": {
    "workflows": [
      ".github/workflows/release.yml", // push main（paths: skills/**）
      ".github/workflows/ci.yml" // merge 後の main の検証（push main）
    ],
    "registration_timeout_minutes": 5,
    "completion_timeout_minutes": 10,
    "max_fix_iterations": 3
  }
}
